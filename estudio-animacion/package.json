{
  "name": "estudio-animacion",
  "version": "0.1.0",
  "private": true,
  "description": "Motor reutilizable de documentales animados 2.5D (Remotion + React + SVG/Canvas)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts Ep01Demo out/frame.png --frame=200",
    "still:states": "remotion still src/index.ts OctopusStates out/states.png --frame=60",
    "render": "remotion render src/index.ts Ep01Demo out/ep01-demo.mp4 --codec=h264 --crf=20",
    "render:draft": "remotion render src/index.ts Ep01Demo out/ep01-demo-draft.mp4 --props=props/draft.json --scale=0.5",
    "render:measured": "node scripts/render-measured.mjs Ep01Demo out/ep01-demo.mp4 --codec=h264 --crf=20",
    "render:segments": "node scripts/render-segments.mjs Ep01Demo 5 out/ep01-demo-segmentos.mp4",
    "typecheck": "tsc --noEmit",
    "sheet": "node scripts/contact-sheet.mjs Ep01Full",
    "ep01:draft": "node scripts/render-episode.mjs --quality draft --scale 0.5 --seg 30 --out out/ep01-borrador-540x960.mp4",
    "ep01:final": "node scripts/render-episode.mjs --quality final --scale 1 --seg 30 --out out/ep01-final-1080x1920.mp4",
    "audio:narration": "python3 tools/audio/narration.py --voice",
    "audio:score": "python3 tools/audio/score.py",
    "ep02:sheet": "node scripts/contact-sheet.mjs Ep02Full",
    "ep02:draft": "node scripts/render-episode.mjs --comp Ep02Full --quality draft --scale 0.5 --seg 30 --out out/ep02-borrador-540x960.mp4",
    "ep02:final": "node scripts/render-episode.mjs --comp Ep02Full --quality final --scale 1 --seg 30 --crf 20 --out out/ep02-final-1080x1920.mp4",
    "audio:score:ep02": "python3 tools/audio/score_ep02.py",
    "ep03:sheet": "node scripts/contact-sheet.mjs Ep03Full",
    "ep03:draft": "node scripts/render-episode.mjs --comp Ep03Full --quality draft --scale 0.5 --seg 30 --out out/ep03-borrador-540x960.mp4",
    "ep03:final": "node scripts/render-episode.mjs --comp Ep03Full --quality final --scale 1 --seg 30 --crf 20 --out out/ep03-final-1080x1920.mp4",
    "audio:score:ep03": "python3 tools/audio/score_ep03.py",
    "still:falcon": "remotion still src/index.ts FalconStates out/falcon-states.png --frame=10",
    "ep04:sheet": "node scripts/contact-sheet.mjs Ep04Full",
    "ep04:draft": "node scripts/render-episode.mjs --comp Ep04Full --quality draft --scale 0.5 --seg 30 --out out/ep04-borrador-540x960.mp4",
    "ep04:final": "node scripts/render-episode.mjs --comp Ep04Full --quality final --scale 1 --seg 30 --crf 20 --out out/ep04-final-1080x1920.mp4",
    "audio:score:ep04": "python3 tools/audio/score_ep04.py",
    "ep05:sheet": "node scripts/contact-sheet.mjs Ep05Full",
    "ep05:draft": "node scripts/render-episode.mjs --comp Ep05Full --quality draft --scale 0.5 --seg 30 --out out/ep05-borrador-540x960.mp4",
    "ep05:final": "node scripts/render-episode.mjs --comp Ep05Full --quality final --scale 1 --seg 30 --crf 20 --out out/ep05-final-1080x1920.mp4",
    "audio:score:ep05": "python3 tools/audio/score_ep05.py",
    "still:ep05": "npx remotion still src/index.ts Ep05Characters out/ep05-planta.png --frame=10 --scale=0.6 && npx remotion still src/index.ts Ep05Creatures out/ep05-mosca-arana.png --frame=10 --scale=0.6",
    "ep06:sheet": "node scripts/contact-sheet.mjs Ep06Full",
    "ep06:draft": "node scripts/render-episode.mjs --comp Ep06Full --quality draft --scale 0.5 --seg 30 --out out/ep06-borrador-540x960.mp4",
    "ep06:final": "node scripts/render-episode.mjs --comp Ep06Full --quality final --scale 1 --seg 30 --crf 20 --out out/ep06-final-1080x1920.mp4",
    "audio:score:ep06": "python3 tools/audio/score_ep06.py",
    "still:ep06": "npx remotion still src/index.ts Ep06Characters out/ep06-fichas.png --frame=10 --scale=0.6"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.545",
    "@remotion/bundler": "4.0.545",
    "@remotion/renderer": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
