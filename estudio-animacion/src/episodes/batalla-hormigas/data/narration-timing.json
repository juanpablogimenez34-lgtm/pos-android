   "drift": 0.0,
   "start": 36.14,
   "end": 39.315,
   "duration": 3.175
  },
  {
   "id": "s2l4",
   "scene": 2,
   "at": 39.7,
   "text": "No tiene aguijón: se defiende mordiendo y rociando secreciones con ácido fórmico.",
