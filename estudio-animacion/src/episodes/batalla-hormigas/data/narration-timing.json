   "drift": 0.0,
   "start": 16.82,
   "end": 19.956,
   "duration": 3.136
  },
  {
   "id": "s2l1",
   "scene": 2,
   "at": 20.4,
   "text": "La hormiga carpintera negra posee un cuerpo robusto y mandíbulas fuertes para transportar alimento, defenderse y trabajar la madera.",
