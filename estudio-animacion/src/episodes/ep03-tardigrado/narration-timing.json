   "end": 4.648,
   "duration": 3.748
  },
  {
   "id": "a2",
   "scene": 1,
   "at": 5.4,
   "text": "Entre gotas de agua y diminutas plantas, vive una criatura extraordinaria.",
   "highlight": [
    "criatura extraordinaria"
   ],
   "drift": 0.0,
   "start": 5.4,
   "end": 10.389,
   "duration": 4.989
  },
  {
   "id": "a3",
   "scene": 1,
   "at": 10.4,
   "text": "La mayoría mide menos de un milímetro.",
