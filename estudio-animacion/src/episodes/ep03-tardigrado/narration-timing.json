   ],
   "drift": 0.0,
   "start": 20.6,
   "end": 24.872,
   "duration": 4.272
  },
  {
   "id": "b2",
   "scene": 2,
   "at": 25.0,
   "text": "Su nombre significa caminante lento.",
   "highlight": [
    "caminante lento"
