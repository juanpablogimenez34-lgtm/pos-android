   "drift": 0.239,
   "start": 10.639,
   "end": 13.114,
   "duration": 2.475
  },
  {
   "id": "a4",
   "scene": 1,
   "at": 13.6,
   "text": "Para verla bien, necesitamos un microscopio. Pero esconde una capacidad que parece imposible.",
   "highlight": [
    "imposible"
   ],
   "drift": 0.0,
   "start": 13.6,
   "end": 19.994,
   "duration": 6.394
  },
  {
   "id": "b1",
   "scene": 2,
   "at": 20.6,
   "text": "Se llama tardígrado, aunque muchos lo conocen como oso de agua.",
   "highlight": [
