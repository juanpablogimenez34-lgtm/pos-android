   "drift": 0.022,
   "start": 34.822,
   "end": 40.771,
   "duration": 5.949
  },
  {
   "id": "b5",
   "scene": 2,
   "at": 40.2,
   "text": "Y algunas resisten condiciones que serían mortales para casi cualquier otro animal.",
