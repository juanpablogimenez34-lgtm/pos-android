   "drift": 0.122,
   "start": 25.122,
   "end": 27.531,
   "duration": 2.409
  },
  {
   "id": "b3",
   "scene": 2,
   "at": 28.2,
   "text": "Tiene ocho patas cortas, terminadas en pequeñas garras, y un cuerpo que parece de otro planeta.",
