 "timing": [
  {
   "id": "e1l1",
   "scene": 1,
   "at": 0.3,
   "text": "¿Qué pasaría si estos dos gigantes del océano se enfrentaran?",
   "highlight": [
    "dos gigantes"
   ],
   "drift": 0.0,
   "start": 0.3,
   "end": 4.069,
   "duration": 3.769
  },
  {
   "id": "e1l2",
   "scene": 1,
   "at": 4.6,
   "text": "El tiburón blanco tiene dientes diseñados para cortar. La orca combina una enorme fuerza física con extraordinarias capacidades cognitivas.",
   "highlight": [
    "dientes diseñados para cortar",
    "capacidades cognitivas"
   ],
   "drift": 0.0,
   "start": 4.6,
   "end": 13.3,
   "duration": 8.7
  },
  {
   "id": "e1l3",
   "scene": 1,
   "at": 13.73,
   "text": "Aquí, la orca tiene ventaja de tamaño. Pero el tiburón posee una poderosa mandíbula y una sorprendente aceleración.",
   "highlight": [
    "ventaja de tamaño",
    "aceleración"
   ],
   "drift": 0.0,
   "start": 13.73,
   "end": 21.613,
   "duration": 7.883
  },
  {
   "id": "e1l4",
   "scene": 1,
   "at": 22.5,
   "text": "Los dos se aproximan. Antes del primer movimiento, tienes que decidir.",
   "highlight": [
    "tienes que decidir"
   ],
   "drift": 0.0,
   "start": 22.5,
   "end": 26.671,
   "duration": 4.171
  },
  {
   "id": "e1l5",
   "scene": 1,
   "at": 29.5,
   "text": "¿Quién dará el primer paso? Observa con atención.",
