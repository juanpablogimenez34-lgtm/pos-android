   "drift": 0.0,
   "start": 64.5,
   "end": 68.183,
   "duration": 3.683
  },
  {
   "id": "e3l1",
   "scene": 3,
   "at": 70.3,
   "text": "La orca tiene una ventaja que el tiburón no puede ignorar.",
   "highlight": [
