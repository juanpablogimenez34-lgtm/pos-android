   "drift": 0.0,
   "start": 58.8,
   "end": 61.789,
   "duration": 2.989
  },
  {
   "id": "o11",
   "scene": 3,
   "at": 62.4,
   "text": "Algunos grupos tienen dialectos propios que se transmiten entre generaciones, como verdaderas tradiciones familiares.",
   "highlight": [
    "dialectos"
