   "drift": 0.0,
   "start": 79.8,
   "end": 85.699,
   "duration": 5.899
  },
  {
   "id": "o15",
   "scene": 4,
   "at": 86.2,
   "text": "Pero no tiene branquias: respira por el espiráculo, en lo alto de la cabeza, y debe volver a la superficie.",
