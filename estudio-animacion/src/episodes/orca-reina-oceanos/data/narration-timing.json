   "drift": 0.0,
   "start": 95.4,
   "end": 99.115,
   "duration": 3.715
  },
  {
   "id": "o17",
   "scene": 5,
   "at": 99.2,
   "text": "Algunas poblaciones de orcas antárticas nadan juntas hacia un témpano de hielo para crear una ola.",
