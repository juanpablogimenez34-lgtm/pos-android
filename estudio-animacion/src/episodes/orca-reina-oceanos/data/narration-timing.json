   "end": 110.842,
   "duration": 5.031
  },
  {
   "id": "o19",
   "scene": 5,
   "at": 111.4,
   "text": "Esta técnica requiere coordinación y experiencia, y se aprende dentro del grupo.",
   "highlight": [
