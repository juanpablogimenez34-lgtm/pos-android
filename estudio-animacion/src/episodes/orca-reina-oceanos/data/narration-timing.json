   "drift": 0.0,
   "start": 62.4,
   "end": 69.301,
   "duration": 6.901
  },
  {
   "id": "o12",
   "scene": 4,
   "at": 70.5,
   "text": "Su cuerpo está perfectamente adaptado a la vida acuática.",
   "highlight": [
    "adaptado"
   ],
   "drift": 0.0,
   "start": 70.5,
   "end": 74.058,
   "duration": 3.558
  },
  {
   "id": "o13",
   "scene": 4,
   "at": 74.2,
   "text": "Potentes músculos impulsan una cola horizontal que se mueve hacia arriba y hacia abajo.",
