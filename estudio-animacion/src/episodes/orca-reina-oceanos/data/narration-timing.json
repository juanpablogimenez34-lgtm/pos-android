    "espiráculo"
   ],
   "drift": 0.0,
   "start": 86.2,
   "end": 93.168,
   "duration": 6.968
  },
  {
   "id": "o16",
   "scene": 5,
   "at": 95.4,
   "text": "Una de sus habilidades más sorprendentes es la cooperación.",
