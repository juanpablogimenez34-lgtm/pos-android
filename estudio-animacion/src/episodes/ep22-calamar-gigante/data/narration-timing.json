   "drift": 0.055,
   "start": 39.055,
   "end": 44.951,
   "duration": 5.896
  },
  {
   "id": "c0407",
   "scene": 4,
   "at": 45.5,
   "text": "Sus ojos están entre los más grandes del reino animal.",
