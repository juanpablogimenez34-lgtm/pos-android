   "end": 18.05,
   "duration": 2.25
  },
  {
   "id": "v301",
   "scene": 3,
   "at": 20.4,
   "text": "Primera revelación: no es un dragón ni un pez. Es un nudibranquio, una babosa marina: Glaucus atlanticus.",
   "highlight": [
    "nudibranquio",
    "babosa marina"
