   "end": 38.476,
   "duration": 7.976
  },
  {
   "id": "a0306",
   "scene": 3,
   "at": 38.3,
   "text": "Cada una produce un voltaje pequeño. Pero cuando se activan a la vez, sus voltajes se suman.",
