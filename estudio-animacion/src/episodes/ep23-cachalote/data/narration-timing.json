   "drift": 0.0,
   "start": 25.4,
   "end": 28.411,
   "duration": 3.011
  },
  {
   "id": "k0300",
   "scene": 3,
   "at": 30.5,
   "text": "Dentro de esa enorme cabeza está el cerebro más pesado conocido entre los animales.",
