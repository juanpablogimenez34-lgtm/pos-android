   "drift": 0.46,
   "start": 19.86,
   "end": 25.022,
   "duration": 5.162
  },
  {
   "id": "k0202",
   "scene": 2,
   "at": 25.4,
   "text": "Y su cabeza ocupa cerca de un tercio del cuerpo.",
