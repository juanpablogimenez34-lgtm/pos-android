   "end": 15.727,
   "duration": 4.424
  },
  {
   "id": "k0200",
   "scene": 2,
   "at": 15.5,
   "text": "El cachalote es el más grande de los cetáceos con dientes.",
   "highlight": [
    "cetáceos con dientes"
