   "drift": 0.477,
   "start": 15.977,
   "end": 19.61,
   "duration": 3.633
  },
  {
   "id": "k0201",
   "scene": 2,
   "at": 19.4,
   "text": "Los machos miden hasta unos dieciséis metros; las hembras, unos doce.",
